# ==============================================================================
# CareSphere Environment Variables Reference
# ==============================================================================

# Server Network Port (Render injects PORT=10000 automatically)
PORT=5001

# Application Environment Mode
NODE_ENV=production

# JSON Web Token Secret (Change to a cryptographically random 64-character secret in production)
JWT_SECRET=caresphere-super-secure-production-jwt-key-2026-replace-with-random-hex

# SQLite Database Location
# In Render Free tier: omitted or ./caresphere.db (auto-seeded on startup)
# In Render Starter tier with Disk: /var/data/caresphere.db
DATABASE_FILE=./caresphere.db

# Optional: Google Gemini API Key for dynamic AI assistant queries
# If omitted or offline, CareSphere's built-in 10-language medical knowledge engine
# handles inquiries, emergency triage, hospital navigation, and FAQs automatically.
GEMINI_API_KEY=

# Optional: Frontend API Base URL (Only needed if deploying client separately as Render Static Site)
# When deploying as recommended Single Web Service, leave this empty.
# VITE_API_BASE_URL=https://caresphere.onrender.com
